# Airflow stack env. Copy to .env.airflow and fill in a real FERNET_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_UID=1000
FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
ENV_FILE_PATH=.env.airflow

# Warehouse connection injected into the Airflow containers (src/config.py reads
# RETAIL_DB_* first, then falls back to DB_*). Not named DB_HOST/DB_PORT because
# the Airflow entrypoint reserves those for its own connection checks.
RETAIL_DB_HOST=retail_dw
RETAIL_DB_PORT=5432
RETAIL_DB_NAME=retail_dw
RETAIL_DB_USER=retail_user
RETAIL_DB_PASSWORD=changeme
